{
    "name": "Flash Attention Dev",
    "image": "nvcr.io/nvidia/pytorch:24.11-py3",
    
    "workspaceFolder": "/flash-attention",
    "workspaceMount": "source=${localWorkspaceFolder},target=/flash-attention,type=bind,consistency=cached",
    
    "runArgs": [
        "--gpus=all",
        "--ipc=host",
        "--ulimit", "memlock=-1", 
        "--ulimit", "stack=67108864",
        "--network=host"
    ],
    
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.debugpy",
                "ms-azuretools.vscode-docker",
                "ms-vscode.cpptools-extension-pack"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/bin/python3",
                "python.linting.enabled": true,
                "python.formatting.provider": "black"
            }
        }
    },
    
    "postCreateCommand": "git config --global --add safe.directory /flash-attention && cd /flash-attention && python setup.py install"
}